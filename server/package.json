    "bs58": "^6.0.0",
    "dotenv": "^17.2.3",
    "hono": "^4.10.7",
    "jose": "^6.2.12",
    "pg": "^8.16.3",
    "viem": "^2.56.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.9.2",
    "@types/pg": "^8.15.6",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
